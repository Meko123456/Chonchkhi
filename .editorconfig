root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_no-wildcard-imports = enabled
# Compose @Composable functions are intentionally PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,yml,yaml,toml}]
indent_size = 2
